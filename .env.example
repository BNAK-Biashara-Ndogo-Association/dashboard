# Google OAuth Web application client ID (public identifier, not a secret).
# Register http://localhost:5173 and http://127.0.0.1:5173 as authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Server-only secrets. Never use a VITE_ prefix for Daraja credentials.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# A public HTTPS URL pointing to port 3001, with the secret path below.
# Example: https://your-tunnel.example/api/mpesa/callback/YOUR_RANDOM_SECRET
MPESA_CALLBACK_URL=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_SECRET=
# Only local dashboard origins can access payment endpoints.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
